# Заполните учётные данные EXBO для используемого режима.
STALZONE_CLIENT_ID=
STALZONE_CLIENT_SECRET=
STALZONE_DEMO_TOKEN=

# Задайте собственный пароль в локальном .env.
STALZONE_CLICKHOUSE_HOST=127.0.0.1
STALZONE_CLICKHOUSE_PORT=8123
STALZONE_CLICKHOUSE_HISTORY_DATABASE=stalzone_history
STALZONE_CLICKHOUSE_SNAPSHOTS_DATABASE=stalzone_snapshots
STALZONE_CLICKHOUSE_USER=stalzone
STALZONE_CLICKHOUSE_PASSWORD=
STALZONE_HISTORY_TTL_DAYS=30
STALZONE_HISTORY_OVERLAP_SECONDS=120
STALZONE_HISTORY_CHUNK_TIMEOUT_SECONDS=30

STALZONE_ENGINE_SCHEDULER_INTERVAL_SECONDS=5
STALZONE_ENGINE_LOTS_SCAN_INTERVAL_SECONDS=180
STALZONE_ENGINE_HISTORY_SYNC_INTERVAL_SECONDS=60
STALZONE_ENGINE_MAX_ACTIVE_ITEMS=2
STALZONE_ENGINE_MAX_HTTP_CONCURRENCY=8
STALZONE_ENGINE_REQUESTS_PER_MINUTE=60
STALZONE_ENGINE_SNAPSHOTS_TTL_DAYS=3
